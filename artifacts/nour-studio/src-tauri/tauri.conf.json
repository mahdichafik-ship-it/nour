{
  "productName": "Nour",
  "version": "0.1.4",
  "identifier": "studio.nour.desktop",
  "build": {
    "beforeBuildCommand": "pnpm run build:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nour — Local Video Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Video",
    "shortDescription": "Local-first video editing for storytellers.",
    "longDescription": "Nour is a local-first video studio for organizing footage, shaping stories, editing, grading, cleaning dialogue, creating captions, and exporting on macOS.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/__NOUR_GITHUB_REPOSITORY__/releases/latest/download/latest.json"
      ],
      "pubkey": "__NOUR_UPDATER_PUBLIC_KEY__"
    }
  }
}