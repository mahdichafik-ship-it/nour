    "desktop:stage-release": "node ./scripts/stage-tauri-macos-release.mjs",
    "desktop:merge-updater": "node ./scripts/merge-tauri-updater-metadata.mjs",
    "desktop:validate-updater": "node ./scripts/validate-tauri-updater-metadata.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
