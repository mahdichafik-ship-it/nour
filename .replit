modules = ["nodejs-24", "rust-stable"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["sh", "scripts/prepare-web-publish.sh"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["pkg-config", "glib", "gtk3", "webkitgtk_4_1", "libsoup_3", "openssl", "cairo", "pango", "gdk-pixbuf", "zlib"]
